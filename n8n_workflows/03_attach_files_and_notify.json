{
  "name": "03_Attach_Files_and_Notify",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "ticket"
            },
            {
              "name": "event"
            },
            {
              "name": "assigned_to"
            }
          ]
        }
      },
      "id": "exec-trigger",
      "name": "Execute Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\n// 'created' was a boolean, which conflated two different outcomes. A duplicate\n// copy of a BCC-distributed RFQ resolves to a ticket that already has the files\n// and the notification, and must be skipped -- but a customer *reply* also\n// resolves to an existing ticket, and it carries new attachments and needs the\n// owner told. One flag could not express both, so the reply path was silently\n// dropping mail.\nconst PROCESS = new Set(['created', 'reply']);\n\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  // Tolerate the old boolean while both workflow versions are in circulation.\n  const event = j.event || (j.created === false ? 'duplicate' : 'created');\n  if (!j.ticket || !PROCESS.has(event)) continue;\n\n  const bin = item.binary || {};\n  const keys = Object.keys(bin);\n  if (!keys.length) { out.push({ json: { ...j, event, _has_files: false } }); continue; }\n  for (const k of keys) {\n    out.push({ json: { ...j, event, _has_files: true, _file_key: k, _file_name: bin[k].fileName },\n               binary: { [k]: bin[k] } });\n  }\n}\nreturn out;\n"
      },
      "id": "split-files",
      "name": "Split Files for Upload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://onespace.kayan-eg.net/api/method/upload_file",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "contentType": "multipart-form-data",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "={{ $json._file_key }}"
            },
            {
              "name": "doctype",
              "value": "Inquiry Ticket"
            },
            {
              "name": "docname",
              "value": "={{ $json.ticket }}"
            },
            {
              "name": "is_private",
              "value": "1"
            }
          ]
        },
        "options": {}
      },
      "id": "upload-file",
      "name": "Upload File to Ticket",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        440,
