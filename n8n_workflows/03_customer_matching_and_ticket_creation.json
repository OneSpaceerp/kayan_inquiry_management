{
  "name": "03_Attach_Files_and_Notify",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "ticket"
            },
            {
              "name": "created"
            },
            {
              "name": "assigned_to"
            }
          ]
        }
      },
      "id": "exec-trigger",
      "name": "Execute Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\n// Only a newly created ticket needs files and a notification. A duplicate copy\n// of a BCC-distributed RFQ resolves to an existing ticket that already has both.\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  if (!j.ticket || j.created === false) continue;\n  const bin = item.binary || {};\n  const keys = Object.keys(bin);\n  if (!keys.length) { out.push({ json: { ...j, _no_files: true } }); continue; }\n  for (const k of keys) out.push({ json: { ...j, _file_key: k, _file_name: bin[k].fileName }, binary: { [k]: bin[k] } });\n}\nreturn out;\n"
      },
      "id": "split-files",
      "name": "Split Files for Upload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://onespace.kayan-eg.net/api/method/upload_file",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "contentType": "multipart-form-data",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "={{ $json._file_key }}"
            },
            {
              "name": "doctype",
              "value": "Inquiry Ticket"
            },
            {
              "name": "docname",
              "value": "={{ $json.ticket }}"
            },
            {
              "name": "is_private",
              "value": "1"
            }
          ]
        },
        "options": {}
      },
      "id": "upload-file",
      "name": "Upload File to Ticket",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        440,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "erpnext-api-token-id",
          "name": "ERPNext API Token Credentials"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://onespace.kayan-eg.net/api/method/kayan_inquiry_management.api.send_sales_engineer_notification",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({inquiry: $json.ticket}) }}",
        "options": {}
      },
      "id": "notify-se",
      "name": "Notify Sales Engineer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        660,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "erpnext-api-token-id",
          "name": "ERPNext API Token Credentials"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Execute Trigger": {
      "main": [
        [
          {
            "node": "Split Files for Upload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Files for Upload": {
      "main": [
        [
          {
            "node": "Upload File to Ticket",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upload File to Ticket": {
      "main": [
        [
          {
            "node": "Notify Sales Engineer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "executionTimeout": 600,
    "binaryMode": "separate"
  },
  "staticData": null,
  "tags": [],
  "triggerCount": 0,
  "active": false
}
